service rst 0x10 C 0x50 MON_SYS_GET
in C
out A
clobbers zero,sign,parity,halfCarry
preserves B,C,D,E,H,L
end
service rst 0x10 C >= 0x60 TECMATE_EXPANSION_SERVICE
in C
out A,carry
clobbers B,C,D,E,H,L,zero,sign,parity,halfCarry
end
service rst 0x10 C 0x60 VDU_INIT
in C
out A,carry
clobbers B,C,D,E,H,L,zero,sign,parity,halfCarry
end
service rst 0x10 C 0x61 TFS_MOUNT
in C
out A,carry
clobbers B,C,D,E,H,L,zero,sign,parity,halfCarry
end
service rst 0x10 C 0x62 RTC_TOOL
in C
out A,carry
clobbers B,C,D,E,H,L,zero,sign,parity,halfCarry
end
service rst 0x10 C 0x63 GLC_ENTRY
in C
out A,carry
clobbers B,C,D,E,H,L,zero,sign,parity,halfCarry
end
service rst 0x10 C 0x64 INP_READ
in C
out A,carry
clobbers B,C,D,E,H,L,zero,sign,parity,halfCarry
end
service rst 0x10 C 0x80 SHL_ENTRY
in C
out A,carry
clobbers B,C,D,E,H,L,zero,sign,parity,halfCarry
end
service rst 0x10 C 0x81 SHL_RUN_COMMAND
in C
out A,carry
clobbers B,C,D,E,H,L,zero,sign,parity,halfCarry
end
service rst 0x10 C 0x82 SHL_RENDER_STATUS
in C
out A,carry
clobbers B,C,D,E,H,L,zero,sign,parity,halfCarry
end
service rst 0x10 C 0x83 SHL_RENDER_RESULT
in C
out A,carry
clobbers B,C,D,E,H,L,zero,sign,parity,halfCarry
end
service rst 0x10 C 0x90 ABI_PROBE_NESTED
in C
out A,carry
clobbers B,C,D,E,H,L,zero,sign,parity,halfCarry
end
extern MON3_MATRIX_SCAN
out D,E,zero
clobbers A,BC,DE,HL,carry,zero,sign,parity,halfCarry
end
extern MON3_PARSE_MATRIX_SCAN
in D,E,zero
out A,carry
clobbers A,BC,HL,carry,zero,sign,parity,halfCarry
end
extern RUN_TRAMPOLINE_BASE
out A,carry,zero
clobbers A,BC,DE,HL,carry,zero,sign,parity,halfCarry
end
