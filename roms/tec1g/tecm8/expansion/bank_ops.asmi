op farCall(bank imm8, target imm16)
        push hl
        push de
        push af
        ld b,bank
        ld hl,target
        ld c,MON_BANK_CALL
        rst 10H
end

op farJump(bank imm8, target imm16)
        push hl
        push de
        push af
        ld b,bank
        ld hl,target
        ld c,MON_FAR_JUMP
        rst 10H
end

op callService(service imm8)
        ld c,service
        rst 10H
end

op callBankService(bank imm8, dispatcher imm16, service imm8)
        push hl
        push de
        ld a,service
        push af
        ld b,bank
        ld hl,dispatcher
        ld c,MON_BANK_CALL
        rst 10H
end
