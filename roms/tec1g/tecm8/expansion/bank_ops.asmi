op farCall(bank imm8, target imm16)
        push hl
        push de
        push af
        ld b,bank
        ld hl,target
        ld c,TECM8_BIOS_BANK_CALL
        rst 10H
end

op farJump(bank imm8, target imm16)
        push hl
        push de
        push af
        ld b,bank
        ld hl,target
        ld c,TECM8_BIOS_FAR_JUMP
        rst 10H
end

op callService(service imm8)
        ld b,0x00
        ld c,service
        push bc
        push hl
        push de
        push af
        ld b,0x00
        ld hl,TECM8_SERVICE_CALL
        ld c,TECM8_BIOS_BANK_CALL
        rst 10H
        inc sp
        inc sp
end

op callBankService(bank imm8, dispatcher imm16, service imm8)
        push hl
        push de
        ld a,service
        push af
        ld b,bank
        ld hl,dispatcher
        ld c,TECM8_BIOS_BANK_CALL
        rst 10H
end
