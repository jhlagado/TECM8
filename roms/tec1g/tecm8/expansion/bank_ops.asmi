; TECM8 expansion-bank call helpers.
;
; These constants deliberately mirror the fixed-ROM RST 10h service numbers.

TECM8_BIOS_SYS_GET          .equ    0x50
TECM8_BIOS_SYS_SET          .equ    0x51
TECM8_BIOS_BANK_SELECT      .equ    0x52
TECM8_BIOS_BANK_CALL        .equ    0x53
TECM8_BIOS_FAR_JUMP         .equ    0x54

TECM8_DEMO_TRACE_BASE       .equ    0x3000
TECM8_DEMO_TRACE_0          .equ    TECM8_DEMO_TRACE_BASE+0
TECM8_DEMO_TRACE_1          .equ    TECM8_DEMO_TRACE_BASE+1
TECM8_DEMO_TRACE_2          .equ    TECM8_DEMO_TRACE_BASE+2
TECM8_DEMO_TRACE_3          .equ    TECM8_DEMO_TRACE_BASE+3
TECM8_DEMO_TRACE_4          .equ    TECM8_DEMO_TRACE_BASE+4
TECM8_DEMO_TRACE_5          .equ    TECM8_DEMO_TRACE_BASE+5
TECM8_DEMO_TRACE_6          .equ    TECM8_DEMO_TRACE_BASE+6
TECM8_DEMO_TRACE_7          .equ    TECM8_DEMO_TRACE_BASE+7
TECM8_DEMO_TRACE_8          .equ    TECM8_DEMO_TRACE_BASE+8
TECM8_DEMO_TRACE_9          .equ    TECM8_DEMO_TRACE_BASE+9
TECM8_ABI_TRACE_BASE        .equ    0x3100
TECM8_ABI_TRACE_0           .equ    TECM8_ABI_TRACE_BASE+0
TECM8_ABI_TRACE_1           .equ    TECM8_ABI_TRACE_BASE+1
TECM8_ABI_TRACE_2           .equ    TECM8_ABI_TRACE_BASE+2
TECM8_ABI_TRACE_3           .equ    TECM8_ABI_TRACE_BASE+3
TECM8_ABI_TRACE_4           .equ    TECM8_ABI_TRACE_BASE+4
TECM8_ABI_TRACE_5           .equ    TECM8_ABI_TRACE_BASE+5
TECM8_ABI_TRACE_6           .equ    TECM8_ABI_TRACE_BASE+6
TECM8_ABI_TRACE_7           .equ    TECM8_ABI_TRACE_BASE+7
TECM8_ABI_TRACE_8           .equ    TECM8_ABI_TRACE_BASE+8
TECM8_ABI_TRACE_9           .equ    TECM8_ABI_TRACE_BASE+9
TECM8_ABI_FARJUMP_LANDED    .equ    0x4100

TECM8_DEMO_BANK0_ENTRY      .equ    0x8000

TECM8_VDU_ENTRY             .equ    0x8000
TECM8_VDU_INIT              .equ    0x8010
TECM8_VDU_CLEAR             .equ    0x8020
TECM8_VDU_SET_CURSOR        .equ    0x8030
TECM8_VDU_PUT_CHAR          .equ    0x8040
TECM8_TMS_INIT              .equ    0x8080
TECM8_TMS_SET_REGISTER      .equ    0x8090
TECM8_TMS_WRITE_VRAM        .equ    0x80A0

TECM8_TECFS_ENTRY           .equ    0x8000
TECM8_TECFS_MOUNT           .equ    0x8010
TECM8_TECFS_SELECT_VOLUME   .equ    0x8020
TECM8_TECFS_READ            .equ    0x8030
TECM8_TECFS_WRITE           .equ    0x8040
TECM8_TECFS_LOAD_RANGE      .equ    0x8050
TECM8_TECFS_SAVE_RANGE      .equ    0x8060

TECM8_RTC_ENTRY             .equ    0x8000
TECM8_RTC_TOOL_ENTRY        .equ    0x8010
TECM8_RTC_SETUP_UI          .equ    0x8020
TECM8_RTC_PRAM_VIEWER       .equ    0x8030

TECM8_ABI_BANK1_NESTED      .equ    0x80C0
TECM8_ABI_BANK2_NESTED      .equ    0x80C0
TECM8_ABI_BANK3_FARJUMP     .equ    0x80C0

op farCall(bank imm8, target imm16)
        ld a,bank
        ld hl,target
        ld c,TECM8_BIOS_BANK_CALL
        rst 10H
end

op farJump(bank imm8, target imm16)
        ld a,bank
        ld hl,target
        ld c,TECM8_BIOS_FAR_JUMP
        rst 10H
end
